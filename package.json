{
  "name": "pi-updater",
  "version": "0.4.0",
  "description": "Auto-updater for pi and its installed extensions. Checks all configured npm packages on startup and (by default) silently updates and restarts.",
  "type": "module",
  "license": "MIT",
  "author": "Toms clanker, Ryan Hughes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanrhughes/pi-updater.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "update"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://github.com/user-attachments/assets/89df2dad-8d91-464b-b3cb-dfd15bce1c06"
  },
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.55.1",
    "@types/node": "^25.3.2",
    "typescript": "^5.9.3"
  }
}
